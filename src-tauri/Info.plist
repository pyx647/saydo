<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 菜单栏常驻程序：不在程序坞显示图标 -->
  <key>LSUIElement</key>
  <true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>SayDo 需要麦克风来听你按住热键时说的指令。</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>SayDo 需要控制其它 App（如 PowerPoint、Keynote、访达）来读取当前文档并替你完成操作。</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>SayDo 需要访问桌面上你选中的文件来完成你交代的任务。</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>SayDo 需要访问"文稿"里你选中的文件，并把成品保存到这里。</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>SayDo 需要访问"下载"里你选中的文件来完成你交代的任务。</string>
</dict>
</plist>
